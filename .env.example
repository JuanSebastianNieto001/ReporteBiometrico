# Credenciales de la biometrica (HikCentral Access Control)
BIO_USUARIO=admin
BIO_CLAVE=

# Cuenta de Gmail desde la que se envia el reporte.
# GMAIL_CLAVE_APP es una "contrasena de aplicacion" de 16 caracteres (NO la clave normal).
# Se crea en: https://myaccount.google.com/apppasswords  (requiere verificacion en 2 pasos activa)
GMAIL_USUARIO=tucuenta@tudominio.com
GMAIL_CLAVE_APP=

# Envío por navegador (Playwright maneja Gmail web). GMAIL_WEB_USER por defecto = GMAIL_USUARIO.
GMAIL_WEB_USER=tucuenta@tudominio.com
GMAIL_WEB_PASS=
